    <!-- Room Acoustic Auto-EQ Wizard -->
    <string name="room_wizard_title">Auto-EQ та калібрування акустики</string>
    <string name="room_wizard_setup_desc">Калібровані свіпи через кожен динамік для розрахунку затримок, кросовера та 16 смуг Auto-EQ.\n⚠️ Музика буде призупинена, а гучність зафіксована на 16 од. (~50%). Двері та вікна мають бути зачинені.</string>
    <string name="room_wizard_subwoofer_title">Конфігурація сабвуфера</string>
    <string name="room_wizard_subwoofer_check">В аудіосистемі встановлено сабвуфер</string>
    <string name="room_wizard_subwoofer_desc">З сабвуфером дверні мідбаси захищаються зрізом HPF на частоті спаду їхньої віддачі, а бас нижче передається на сабвуфер. Без сабвуфера мідбаси грають максимально низько із захистом від інфразвуку.</string>
    <string name="room_wizard_target_title">Цільова крива звучання</string>
    <string name="room_wizard_target_harman">Harman Reference (еталон автозвуку)</string>
    <string name="room_wizard_target_harman_desc">Приємний теплий суббас та комфортні ВЧ. Золотий стандарт.</string>
    <string name="room_wizard_target_dolby">Dolby Atmos 3D Cinema (кінотеатр)</string>
    <string name="room_wizard_target_dolby_desc">Глибокий бас, розбірливий голос + апаратний об\'ємний 3D-звук.</string>
    <string name="room_wizard_target_bass">Club / Bass Heavy (клубний драйв)</string>
    <string name="room_wizard_target_bass_desc">Потужний панч та сабвуфер для електронної музики й хіп-хопу.</string>
    <string name="room_wizard_target_vocal">Vocal / Podcast (голос та аудіокниги)</string>
    <string name="room_wizard_target_vocal_desc">Підкреслена чіткість мовлення без бубніння й низькочастотного гулу.</string>
    <string name="room_wizard_target_flat">Studio Flat (студійна лінійна)</string>
    <string name="room_wizard_target_flat_desc">Максимально точне та аналітичне студійне відтворення без забарвлення.</string>
    <string name="room_wizard_soundstage_title">Фокусування сцени (затримки)</string>
    <string name="room_wizard_stage_driver">Сцена на водія</string>
    <string name="room_wizard_stage_driver_desc">Часове вирівнювання за мікрофоном (TDOA): звук досягає водія одночасно.</string>
    <string name="room_wizard_stage_front_center">По центру спереду</string>
    <string name="room_wizard_stage_front_center_desc">Симетричний фронт для водія та пасажира + об\'ємний тил.</string>
