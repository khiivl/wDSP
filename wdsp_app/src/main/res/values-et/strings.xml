    <string name="system_report_working">Kogumine…</string>
    <string name="system_report_title">Süsteemi aruanne</string>
    <string name="system_report_saved">Salvestatud:\n\n%1$s\n\nHelitugevuse vea tabamiseks tehke üks lühike telefonikõne Bluetoothi kaudu, lõpetage kõne ja koguge aruanne teist korda. Teine fail sisaldab kõne ajal toimunud muutusi.</string>
