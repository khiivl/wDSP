    <string name="status_bar_placement_hint">Lad højden være 0, så måler appen selv bjælken. Indstil den kun manuelt, hvis striben lander det forkerte sted — på nogle bilradioer tegnes den øverste bjælke af launcheren, og Android ved ikke, den er der.</string>
    <string name="freq_off">Fra</string>
    <string name="system_report_label">Systemrapport</string>
    <string name="system_report_desc">Skriver ned, hvordan denne enhed håndterer lydstyrke, routing og mikrofonen. Nødvendigt for at rette nulstilling af lydstyrken efter et Bluetooth-opkald, stille navigationsmeddelelser og en måling, der ikke vil starte.</string>
    <string name="system_report_button">Saml</string>
    <string name="system_report_working">Samler…</string>
    <string name="system_report_title">Systemrapport</string>
    <string name="system_report_saved">Gemt i:\n\n%1$s\n\nFor også at fange lydstyrkefejlen: foretag et kort telefonopkald over Bluetooth, læg på, og saml rapporten en anden gang. Den anden fil vil indeholde, hvad der ændrede sig under opkaldet.</string>
    <string name="system_report_failed">Rapporten kunne ikke skrives.</string>
    <string name="mic_denied_title">Ingen mikrofon</string>
    <string name="mic_denied">Android beder ikke om mikrofonen længere, fordi tilladelsen blev afvist tidligere. Intet kan måles uden den.\n\nÅpne Indstillinger → Apps → wDSP → Tilladelser og tillad mikrofonen, og prøv derefter igen.</string>
