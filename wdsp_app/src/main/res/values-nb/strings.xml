    <string name="freq_off">Av</string>
    <string name="system_report_label">Systemrapport</string>
    <string name="system_report_desc">Skriver ned hvordan denne enheten håndterer volum, ruting og mikrofonen. Nødvendig for å fikse tilbakestilling av volum etter en Bluetooth-samtale, stille navigasjonsmeldinger og en måling som ikke vil starte.</string>
