    <string name="system_report_title">Systemrapport</string>
    <string name="system_report_saved">Lagret i:\n\n%1$s\n\nFor også å fange volumfeilen: ta en kort telefonsamtale over Bluetooth, legg på, og samle rapporten en gang til. Den andre filen vil inneholde det som endret seg under samtalen.</string>
