<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.WDSP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/cyan_custom</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>

        <!-- Disables the default click "boop" sound effect for every View
             in the app in one place, instead of calling
             setSoundEffectsEnabled(false) on each button individually. This
             works because View's constructor resolves any attribute it
             doesn't get explicitly (from XML or code) through the current
             theme - including for widgets created programmatically with
             `new Foo(context)`, like the per-band EQ sliders/toggles built
             at runtime in MainActivity.setupEqBands(). Matters here because
             those UI click sounds were getting captured by the spectrum
             analyzer's Visualizer (session 0 sees the whole output mix,
             including UI sound effects, not just music). -->
        <item name="android:soundEffectsEnabled">false</item>

    </style>

    <style name="Theme.WDSP" parent="Base.Theme.WDSP" />

    <!-- Standard Text Styles -->
    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextHeader">
        <item name="android:textSize">@dimen/text_size_header</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextLabel">
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextValue">
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware_2</item>
    </style>

    <!-- 1. The Square Shape -->
    <style name="ShapeAppearance.Square" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/button_radius</item>
    </style>

    <!-- 2. The Indicator Style (Explicitly setting parent to empty to avoid lookup) -->
    <style name="IndicatorSquare" parent="">
        <!-- This is the internal property for the indicator's shape -->
        <item name="shapeAppearance">@style/ShapeAppearance.Square</item>
        <item name="android:color">@color/custom_square</item>
        <!-- Optional: Set height and width here if you want it to be a perfect square -->
        <item name="android:width">33dp</item>
        <item name="android:height">33dp</item>
    </style>

</resources>