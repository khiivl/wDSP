<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.WDSP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan_custom</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/main_font</item>
        <item name="fontFamily">@font/main_font</item>
        <item name="android:soundEffectsEnabled">false</item>

        <!-- Global UI Widgets Styling matching QFRadio -->
        <item name="seekBarStyle">@style/CustomSeekBarStyle</item>
        <item name="android:seekBarStyle">@style/CustomSeekBarStyle</item>
        <item name="sliderStyle">@style/CustomSliderStyle</item>
        <item name="bottomNavigationStyle">@style/CustomBottomNavStyle</item>
        <item name="materialAlertDialogTheme">@style/CustomDialogTheme</item>
        <item name="alertDialogTheme">@style/CustomDialogTheme</item>
        <item name="materialButtonStyle">@style/CustomMaterialButtonStyle</item>
    </style>

    <style name="Theme.WDSP" parent="Base.Theme.WDSP" />

    <!-- Material Dialog Theme -->
    <style name="CustomDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/card_bg_theme_aware</item>
        <item name="colorOnSurface">@color/text_theme_aware</item>
        <item name="colorOnSurfaceVariant">@color/text_theme_aware_2</item>
        <item name="android:textColorPrimary">@color/text_theme_aware</item>
        <item name="android:textColorSecondary">@color/text_theme_aware_2</item>
        <item name="colorPrimary">@color/cyan_custom</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/cyan_custom</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/custom_square</item>
    </style>

    <style name="CustomMaterialButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeWidth">1.2dp</item>
        <item name="strokeColor">@color/panel_border_theme_aware</item>
        <item name="backgroundTint">@color/card_bg_theme_aware</item>
        <item name="rippleColor">@color/custom_square</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <!-- SeekBar Styling -->
    <style name="CustomSeekBarStyle" parent="@android:style/Widget.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:maxHeight">24dp</item>
    </style>

    <!-- Material Slider Styling -->
    <style name="CustomSliderStyle" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/track_color_active</item>
        <item name="trackColorInactive">@color/track_color_inactive</item>
        <item name="thumbColor">@color/track_color_active</item>
        <item name="haloColor">@color/transparent</item>
        <item name="thumbRadius">10dp</item>
        <item name="thumbWidth">20dp</item>
        <item name="thumbHeight">20dp</item>
        <item name="trackHeight">5dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="tickVisibilityMode">hidden</item>
        <item name="labelBehavior">gone</item>
    </style>

    <!-- Bottom Navigation Bar Styling -->
    <style name="CustomBottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemIconTint">@color/nav_item_color_selector</item>
        <item name="itemTextColor">@color/nav_item_color_selector</item>
        <item name="itemRippleColor">@color/transparent</item>
        <item name="itemActiveIndicatorStyle">@style/CustomNavIndicator</item>
    </style>

    <style name="CustomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/custom_square</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Square</item>
    </style>

    <!-- Standard Text Styles -->
    <!-- Standard Text Styles Hierarchy -->
    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextHeader">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextLabel">
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextValue">
        <item name="android:textSize">@dimen/text_size_value</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_theme_aware</item>
    </style>

    <style name="TextDesc">
        <item name="android:textSize">@dimen/text_size_note</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_theme_aware_2</item>
    </style>

    <!-- The Square Shape -->
    <style name="ShapeAppearance.Square" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/button_radius</item>
    </style>

    <!-- The Indicator Style -->
    <style name="IndicatorSquare" parent="">
        <item name="shapeAppearance">@style/ShapeAppearance.Square</item>
        <item name="android:color">@color/custom_square</item>
        <item name="android:width">33dp</item>
        <item name="android:height">33dp</item>
    </style>

</resources>