<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Sizes Hierarchy: Title (24sp) -> Subtitle/Header (18sp bold) -> Label/Slider (16sp) -> Desc/Note (14sp) -->
    <dimen name="text_size_title">24sp</dimen>
    <dimen name="text_size_header">18sp</dimen>
    <dimen name="text_size_subtitle">18sp</dimen>
    <dimen name="text_size_label">16sp</dimen>
    <dimen name="text_size_value">16sp</dimen>
    <dimen name="text_size_small">14sp</dimen>
    <dimen name="text_size_note">14sp</dimen>
    <dimen name="text_size_log">12sp</dimen>
    <dimen name="text_size_button">16sp</dimen>

    <!-- Paddings and Margins -->
    <dimen name="padding_standard">16dp</dimen>
    <dimen name="padding_small">8dp</dimen>
    <dimen name="margin_standard">16dp</dimen>
    <dimen name="margin_small">8dp</dimen>
    <dimen name="margin_tiny">4dp</dimen>

    <!-- Component Sizes -->
    <dimen name="slider_track_height">5dp</dimen>
    <dimen name="control_block_max_width">340dp</dimen>
    <dimen name="fader_length">300dp</dimen>
    <!-- Gap left/right and top/bottom of the car image so a borderless arrow
         icon plus its step-count label fit stacked/side-by-side in the
         margin, centered around the car. -->
    <dimen name="fader_arrow_gap_h">28dp</dimen>
    <dimen name="fader_arrow_gap_v">24dp</dimen>
    <dimen name="fader_arrow_icon_size">36dp</dimen>
    <dimen name="fader_arrow_label_size">28dp</dimen>
    <!-- The car with its arrows and numbers is laid out once, at the size it has on the 1280x720
         reference (the right half of 1280x648dp of content), and scaled whole to fit whatever
         room a panel leaves - see ScaleToFitLayout. -->
    <dimen name="fader_group_width">640dp</dimen>
    <dimen name="fader_group_height">648dp</dimen>
    <!-- Room kept free under content for the floating navigation pill. Measured by uiautomator on
         every geometry, 11.09.2026: the pill and its margin take 82dp from the bottom (74 + 8), so
         the 76dp used before left the rear fader arrow 2dp under it. 82 plus a small gap. -->
    <dimen name="bottom_nav_clearance">88dp</dimen>

    <!-- Button Sizes -->
    <dimen name="button_radius">10dp</dimen>
    <dimen name="stroke_width">1.5dp</dimen>
    <dimen name="button_width">45dp</dimen>
    <dimen name="button_height">55dp</dimen>

    <dimen name="thumb_height">20dp</dimen>
    <!-- The microphone-placement car in Diagnostics. 300dp is half of a 1024x600 fascia and
         well under half of a 1280x720 one, so the arrows above and below it stay on screen
         without the page having to be scrolled to find them. Density is 1.0 on these units, so
         dp and px are the same thing here. -->
    <dimen name="room_mic_car_height">300dp</dimen>
</resources>