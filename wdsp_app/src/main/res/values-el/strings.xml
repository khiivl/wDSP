    <string name="room_measure_saved_title">Η μέτρηση αποθηκεύτηκε</string>
    <string name="room_measure_saved">Το αρχείο με %2$d αρχεία γράφτηκε στο:\n\n%1$s\n\nΑνοίξτε το με έναν διαχειριστή αρχείων ή αντιγράψτε το με καλώδιο USB ή κάρτα μνήμης.</string>
