    <string name="room_measure_saved_title">Měření uloženo</string>
    <string name="room_measure_saved">Archiv s %2$d soubory byl zapsán do:\n\n%1$s\n\nOtevřete jej pomocí správce souborů nebo jej zkopírujte přes USB kabel či paměťovou kartu.</string>
