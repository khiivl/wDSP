    <!-- Diagnostics: cabin measurement -->
    <string name="debug_section_title">Diagnose</string>
    <string name="room_measure_label">Messung des Innenraums</string>
    <string name="room_measure_desc">Spielt nacheinander einen Sweep über jeden Lautsprecher und misst, wann der Ton ankam und ob er phasenrichtig ist. Dauert etwa eine halbe Minute. Motor aus, Türen zu, normale Lautstärke.</string>
