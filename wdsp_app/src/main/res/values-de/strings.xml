    <string name="room_measure_saved_title">Messung gespeichert</string>
    <string name="room_measure_saved">Das Archiv mit %2$d Dateien wurde geschrieben nach:\n\n%1$s\n\nÖffnen Sie es mit einem Dateimanager oder kopieren Sie es über ein USB-Kabel oder eine Speicherkarte.</string>
    <string name="room_measure_save_failed">Das Archiv konnte nicht geschrieben werden.</string>
