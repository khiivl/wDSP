<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Fill must be transparent -->
    <solid android:color="@android:color/transparent" />

    <!-- 2. The Outline (The "Caret") -->
    <stroke
        android:width="2dp"
        android:color="@color/custom_square" />

    <!-- 3. The Corners (Matches your Square style) -->
    <!-- Use 0dp for sharp corners or a small dp for slight rounding -->
    <corners android:radius="@dimen/button_radius" />
</shape>