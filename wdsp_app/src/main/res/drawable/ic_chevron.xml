<?xml version="1.0" encoding="utf-8"?>
<!-- The fold mark of a disclosure title (ui/Disclosure): "^" while open, turned 180 when closed.
     Not ic_arrow: that one is a hairline at half alpha, made for the arrows around the car, and
     is hard to see on a head-unit screen in daylight. The colour is only a default - the theme
     tints it like its title (MainActivity.applyAppTheme). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M6,15 L12,9 L18,15"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/text_theme_aware"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
