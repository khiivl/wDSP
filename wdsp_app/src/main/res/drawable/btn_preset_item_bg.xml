<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_press_color"/>
            <corners android:radius="@dimen/dp_h10"/>
            <gradient
                android:startColor="@color/btn_press_start_color"
                android:endColor="@color/btn_press_color"
                android:angle="90"
                android:type="linear"
                android:centerY="0.4"
                android:centerColor="@color/btn_press_center_color"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_press_color"/>
            <corners android:radius="@dimen/dp_h10"/>
            <gradient
                android:startColor="@color/btn_press_start_color"
                android:endColor="@color/btn_press_color"
                android:angle="90"
                android:type="linear"
                android:centerY="0.4"
                android:centerColor="@color/btn_press_center_color"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_normal_color"/>
            <corners android:radius="@dimen/dp_h10"/>
            <gradient
                android:startColor="@color/btn_normal_start_color"
                android:endColor="@color/btn_normal_color"
                android:angle="90"
                android:type="linear"
                android:centerY="0.8"
                android:centerColor="@color/btn_normal_center_color"/>
        </shape>
    </item>
</selector>
